<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>SceneMaker.App</RootNamespace>
    <DefaultItemExcludes>$(DefaultItemExcludes);src/SceneMaker.Core/**;src/SceneMaker.Cli/**;tests/**;.godot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src/SceneMaker.Core/SceneMaker.Core.csproj" />
  </ItemGroup>
</Project>
